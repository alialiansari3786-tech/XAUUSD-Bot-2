# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Claude API
CLAUDE_API_KEY=your_claude_api_key_here

# Bot Configuration
SCAN_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# Data Configuration
# GC=F = Gold Futures (COMEX) - most reliable for yfinance
# Note: XAUUSD=X was delisted by yfinance, use GC=F instead
YFINANCE_TICKER=GC=F
DATA_STORAGE_PATH=data/

# Twelve Data API (Fallback source - real-time data)
# Get your free API key at: https://twelvedata.com/
# Free tier: 800 calls/day, real-time data with 1-min delay
TWELVE_DATA_API_KEY=2d0afc09cfa64b3fb45f86cb17c11da8
TWELVE_DATA_SYMBOL=XAUUSD
ENABLE_TWELVE_DATA_FALLBACK=true

# CSV Data (For backtesting)
CSV_DATA_PATH=data/historical/

# Chart Configuration
CHART_STORAGE_PATH=charts/
CHART_DPI=150
CHART_STYLE=dark

# Trading Configuration
MIN_CONFLUENCE_SCORE_METHOD1=6
MIN_CONFLUENCE_SCORE_METHOD2=5
MIN_CONFLUENCE_SCORE_METHOD3=7

# Risk Parameters (for reference only - bot does not execute trades)
DEFAULT_RISK_PERCENT=1.0
MAX_TRADES_PER_DAY=5

# Feature Flags
ENABLE_DAILY_SUMMARY=true
ENABLE_WEEKLY_RECAP=true
ENABLE_SCREENSHOT_ANALYSIS=false
ENABLE_ALL_METHODS=true
